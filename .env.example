# Base URL of the CIB backend API.
# Copy this file to .env.local and change the value for your environment.
# Defaults to http://localhost:1990 when unset.
VITE_API_URL=http://localhost:1990

# WhatsApp number for the support button shown to ADMIN users, in international format
# without "+" (e.g. 2348012345678). The button is hidden when unset.
VITE_SUPPORT_WHATSAPP=
